                "description": "Validation Error",
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/HTTPValidationError"
                    }
                  }
                }
              }
            }
          }
        },
        "/queue-status": {
          "get": {
            "summary": "Состояние очереди и настройки batching",
            "operationId": "queue_status_queue_status_get",
