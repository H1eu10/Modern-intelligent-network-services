    "body": {
      "openapi": "3.1.0",
      "info": {
        "title": "Agro Scoring API",
        "description": "Agro Scoring API: request_id, SQLite/aiosqlite, single inference, batching и интеграция с Vireonix LLM.",
        "version": "4.0.0"
      },
      "paths": {
        "/health": {
          "get": {
            "summary": "Проверка состояния API",
            "operationId": "health_health_get",
            "responses": {
              "200": {
                "description": "Successful Response",
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/HealthResponse"
                    }
                  }
                }
              }
            }
          }
        },
        "/model-info": {
          "get": {
            "summary": "Информация о модели",
            "operationId": "model_info_model_info_get",
            "responses": {
              "200": {
                "description": "Successful Response",
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/ModelInfoResponse"
                    }
                  }
                }
              }
            }
          }
        },
        "/llm/chat": {
          "post": {
            "summary": "Прямой учебный запрос к Vireonix LLM",
            "description": "Отправляет prompt в OpenAI-совместимый Vireonix API. API-ключ и Authorization header не используются. Не передавайте реальные конфиденциальные данные.",
            "operationId": "llm_chat_llm_chat_post",
            "requestBody": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/LLMChatRequest"
                  }
                }
              },
              "required": true
            },
            "responses": {
              "200": {
                "description": "Successful Response",
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/LLMChatResponse"
                    }
                  }
                }
              },
              "422": {
                "description": "Validation Error",
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/HTTPValidationError"
                    }
                  }
                }
              }
            }
          }
        },
        "/predict-with-llm": {
          "post": {
            "summary": "Агроскоринг с текстовым объяснением LLM",
            "description": "Сначала выполняет детерминированный агроскоринг и сохраняет результат в SQLite. Затем Vireonix LLM формирует только текстовое объяснение результата. LLM не определяет risk_score.",
            "operationId": "predict_with_llm_predict_with_llm_post",
            "requestBody": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/FarmRequest"
                  }
                }
              },
              "required": true
            },
            "responses": {
              "200": {
                "description": "Successful Response",
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/PredictWithLLMResponse"
                    }
                  }
                }
              },
              "422": {
                "description": "Validation Error",
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/HTTPValidationError"
                    }
                  }
                }
              }
            }
          }
        },
        "/predict": {
          "post": {
            "summary": "Одиночный inference",
            "description": "Один HTTP-request -> один inference -> одна запись SQLite.",
            "operationId": "predict_predict_post",
            "requestBody": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/FarmRequest"
                  }
                }
              },
              "required": true
            },
            "responses": {
              "200": {
                "description": "Successful Response",
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/PredictionResponse"
                    }
                  }
                }
              },
              "422": {
                "description": "Validation Error",
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/HTTPValidationError"
                    }
                  }
                }
              }
            }
          }
        },
        "/batch-predict": {
          "post": {
            "summary": "Явный пакетный inference",
            "description": "Клиент сам передает несколько хозяйств одним HTTP-запросом.\n\nВсе результаты batch сохраняются в SQLite одной транзакцией:\nexecutemany() + один commit().",
            "operationId": "batch_predict_batch_predict_post",
            "requestBody": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/BatchRequest"
