          "get": {
            "summary": "Получить историю прогнозов из SQLite",
            "operationId": "get_predictions_predictions_get",
            "parameters": [
              {
                "name": "limit",
                "in": "query",
                "required": false,
                "schema": {
                  "type": "integer",
                  "maximum": 100,
                  "minimum": 1,
                  "default": 10,
                  "title": "Limit"
                }
              },
              {
                "name": "risk_level",
                "in": "query",
                "required": false,
                "schema": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "low, medium или high",
                  "title": "Risk Level"
                },
                "description": "low, medium или high"
              }
            ],
            "responses": {
              "200": {
                "description": "Successful Response",
                "content": {
                  "application/json": {
